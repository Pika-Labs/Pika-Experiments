# PikaAgentEditor server env
# Copy this to .env and fill in real values. .env is gitignored.
#
# All three keys can also be set in-app via the model-pill UI in the top-right
# (it writes back to this file via server/src/agent/config.ts). The fields
# below are documented here so the boot script knows which env vars exist
# even when the in-app setter hasn't run yet.

# Required for the in-app chat agent (claude-opus-4-7) and the Pika MCP
# bridge that runs through it. Get a key from https://console.anthropic.com
# — the Max plan's monthly credit pool meters at API rates against this key.
ANTHROPIC_API_KEY=

# Required for voice mode (mic button in the chat header). Routes audio
# through OpenAI's realtime API (gpt-realtime). Get a key from
# https://platform.openai.com — the in-app agent fetches an ephemeral
# session token per call, so this key never leaves the server.
OPENAI_API_KEY=

# (SFX + music both run through the Pika MCP now — no separate
# ElevenLabs API key needed. Connect Pika from the chat panel.)
