# Voice Stage — local environment
# Copy this file to `.env` and fill in real values. The real `.env` is git-ignored.

# Required: OpenAI key with Realtime API access.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: realtime model & voice
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Pika MCP endpoint. Leave as-is unless you're running a custom MCP server.
PIKA_MCP_URL=https://mcp.pika.me/api/mcp

# Optional: Google Workspace OAuth (Calendar / Gmail / Drive / Docs / Sheets / Slides / Tasks / Contacts).
# Create an OAuth Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly: http://localhost:3000/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local server port.
PORT=3000
